# Dependencies
/node_modules
/.pnp
.pnp.*
# Keep authored Yarn tooling if the project adopts Yarn.
/.yarn/*
!/.yarn/patches/
!/.yarn/plugins/
!/.yarn/releases/
!/.yarn/versions/

# Generated builds and framework state
/dist/
/.next/
/.vinext/
/out/
next-env.d.ts
*.tsbuildinfo

# Test output
/coverage/

# Package-manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Local environment and keys
.env*
.dev.vars*
*.pem

# Checkout-local tool state
/.wrangler/
/.sites-runtime/

# Workspace scaffolding and publication archives
/.agents/
/.codex/
/outputs/
/work/

# OS metadata
.DS_Store

# Documented templates contain placeholders only
!.env.example
!.dev.vars.example

# Never publish runtime reference exports or student evidence
/academic-reference*.json
/source-inventory*.json
/*-import-reconciliation*.json
/sources/
/private-data/
*.sqlite
*.sqlite3
*.db

# Independent hosting configuration contains private account settings
/.cloudflare/
